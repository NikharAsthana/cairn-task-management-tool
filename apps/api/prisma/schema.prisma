// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}   

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  ON_HOLD
  DONE
}

enum Priority {
  NO_PRIORITY
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String?  @unique
  fullName    String
  username    String   @unique
  title       String?
  isGuest     Boolean  @default(true)
  googleId    String?  @unique
  // Google's unique identifier for this person — lets repeat Google
  // logins resolve to the same User row instead of creating duplicates.
  // Not in your original diagram; needed once we knew the auth method.
  avatarUrl   String?
  // Not in your diagram either — Google's OAuth response includes a
  // profile photo for free, worth capturing.
  themeMode   String   @default("light")
  accentColor String   @default("blue")
  workspaceId String   @db.Uuid

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectsLed     Project[]      @relation("ProjectLead")
  tasksReported   Task[]         @relation("TaskReporter")
  taskAssignments TaskAssignee[]
  comments        Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  users     User[]
  projects  Project[]
  createdAt DateTime  @default(now())

  @@map("workspaces")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  priority    Priority  @default(NO_PRIORITY)
  dueDate     DateTime?
  workspaceId String    @db.Uuid
  leadId      String    @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      User      @relation("ProjectLead", fields: [leadId], references: [id], onDelete: Restrict)
  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@map("projects")
}

model Task {
  id           String     @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(NO_PRIORITY)
  dueDate      DateTime?
  projectId    String     @db.Uuid
  parentTaskId String?    @db.Uuid
  reporterId   String     @db.Uuid

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask Task?          @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]         @relation("Subtasks")
  reporter   User           @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignees  TaskAssignee[]
  labels     TaskLabel[]
  comments   Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

model Label {
  id    String      @id @default(uuid()) @db.Uuid
  name  String
  color String
  tasks TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  taskId  String @db.Uuid
  labelId String @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

model Comment {
  id       String @id @default(uuid()) @db.Uuid
  body     String
  taskId   String @db.Uuid
  authorId String @db.Uuid

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("comments")
}